library(tidyverse)
library(gapminder)
library(plotly)
library(DT)
library(scales)
library (viridis)
gapminder_data <- gapminder %>%
rename(
life_expectancy = lifeExp,
population = pop,
gdp_per_capita = gdpPercap
)
gapminder_2007 <- gapminder_data %>%
filter(year == 2007)
interactive_scatterplot <- ggplot(
data = gapminder_2007,
mapping = aes(
x = gdp_per_capita,
y = life_expectancy,
color = continent,
text = paste0(
"<b>", country, "</b>",
"<br>Continent: ", continent,
"<br>Life expectancy: ",
round(life_expectancy, 1),
" years",
"<br>GDP per capita: ",
scales::dollar(round(gdp_per_capita)),
"<br>Population: ",
scales::comma(population)
)
)
) +
geom_point(
size = 3,
alpha = 0.8
) +
scale_x_log10(
labels = scales::label_dollar()
) +
scale_color_viridis_d() +
labs(
title = "Explore Life Expectancy and GDP per Capita",
subtitle = "Hover over a point to inspect a country",
x = "GDP per capita",
y = "Life expectancy in years",
color = "Continent"
) +
theme_minimal(base_size = 13)
ggplotly(
interactive_scatterplot,
tooltip = "text"
) %>%
config(
displaylogo = FALSE,
responsive = TRUE
)
#| echo: false
continent_trends <- gapminder_data %>%
group_by(continent, year) %>%
summarize(
mean_life_expectancy =
mean(
life_expectancy,
na.rm = TRUE
),
.groups = "drop"
)
interactive_trend <- ggplot(
continent_trends,
aes(
x = year,
y = mean_life_expectancy,
color = continent,
text = paste0(
"<b>", continent, "</b>",
"<br>Year: ", year,
"<br>Mean life expectancy: ",
round(mean_life_expectancy, 1),
" years"
)
)
) +
geom_line(linewidth = 1) +
geom_point(size = 1.8) +
scale_color_viridis_d() +
labs(
title = "Mean Life Expectancy Increased Across Continents",
subtitle = "Hover over a point or zoom into a time period",
x = "Year",
y = "Mean life expectancy in years"
) +
theme_minimal(base_size = 13)
ggplotly(
interactive_trend,
tooltip = "text",
dynamicTicks = TRUE
) %>%
layout(
hovermode = "x unified"
) %>%
config(
displaylogo = FALSE,
responsive = TRUE
)
#| echo: false
table_data <- gapminder_2007 %>%
transmute(
Country = country,
Continent = continent,
`Life expectancy` =
round(life_expectancy, 1),
`GDP per capita` =
round(gdp_per_capita),
Population = population
)
datatable(
table_data,
rownames = FALSE,
filter = "top",
extensions = "Buttons",
options = list(
pageLength = 10,
autoWidth = TRUE,
dom = "Bfrtip",
buttons = c(
"copy",
"csv",
"excel"
)
),
caption =
htmltools::tags$caption(
style =
"caption-side: top; text-align: left;",
"Country-level indicators in 2007"
)
) %>%
formatCurrency(
columns = "GDP per capita",
currency = "$",
digits = 0
) %>%
formatRound(
columns = "Life expectancy",
digits = 1
) %>%
formatRound(
columns = "Population",
digits = 0
)
