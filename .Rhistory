install.packages("shiny")
install.packages("learnr")
installed.packages(shiny)
installed.packages(learnr)
"shiny" %in% rownames(installed.packages())
"learnr" %in% rownames(installed.packages())
#| echo: false
library(tidyverse)
library(gapminder)
library(plotly)
library(DT)
library(scales)
library (viridis)
gapminder_data <- gapminder %>%
rename(
life_expectancy = lifeExp,
population = pop,
gdp_per_capita = gdpPercap
)
gapminder_2007 <- gapminder_data %>%
filter(year == 2007)
interactive_scatterplot <- ggplot(
data = gapminder_2007,
mapping = aes(
x = gdp_per_capita,
y = life_expectancy,
color = continent,
text = paste0(
"<b>", country, "</b>",
"<br>Continent: ", continent,
"<br>Life expectancy: ",
round(life_expectancy, 1),
" years",
"<br>GDP per capita: ",
scales::dollar(round(gdp_per_capita)),
"<br>Population: ",
scales::comma(population)
)
)
) +
geom_point(
size = 3,
alpha = 0.8
) +
scale_x_log10(
labels = scales::label_dollar()
) +
scale_color_viridis_d() +
labs(
title = "Explore Life Expectancy and GDP per Capita",
subtitle = "Hover over a point to inspect a country",
x = "GDP per capita",
y = "Life expectancy in years",
color = "Continent"
) +
theme_minimal(base_size = 13)
ggplotly(
interactive_scatterplot,
tooltip = "text"
) %>%
config(
displaylogo = FALSE,
responsive = TRUE
)
